# Create a project at https://www.sanity.io/manage, then copy this file to
# .env.local and fill in the values. Until these are set, pages fall back
# to the local seed data in src/lib/ so the site still runs.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Only needed if/when Studio content editing requires authenticated writes
# from server code (not used by the read-only queries in lib/).
SANITY_API_TOKEN=

# Create an account at https://resend.com, verify a sending domain, then
# fill these in. Until both are set, the /api/inquiry route logs form
# submissions to the server console instead of emailing them, so the
# Brands/Wholesale/Service/About/Contact forms are fully testable without
# real credentials.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Department inboxes for routed inquiries. All default to info@centrometal.me
# (the only confirmed address from the brief) until the client provides
# dedicated addresses.
INQUIRY_EMAIL_RETAIL=
INQUIRY_EMAIL_WHOLESALE=
INQUIRY_EMAIL_SERVICE=
